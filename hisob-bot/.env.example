BOT_TOKEN=123456:your-telegram-bot-token-here

# Lokal test uchun (ixtiyoriy, standart holatda ./hisob.db fayliga saqlanadi)
DB_PATH=./hisob.db

# Turso (bulutli, doimiy) baza uchun - lokal DB_PATH o'rniga shularni to'ldiring
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Render/webhook rejimi uchun (Render'da avtomatik RENDER_EXTERNAL_URL beriladi,
