PORT=8080
JWT_SECRET=change-this-to-a-long-random-string

# ---- Ma'lumotlar bazasi ----
# O'rnatilsa -> Postgres (doimiy saqlash). Bo'sh qoldirilsa -> xotira (faqat dev).
# Masalan: postgres://user:parol@host:5432/dbname
# Lokal TLS'siz Postgres uchun oxiriga ?sslmode=disable qo'shing.
DATABASE_URL=

# ---- STUN/TURN (WebRTC) ----
# Mijozlar bularni /ice-servers endpointidan oladi (kodga yozilmaydi).
# TURN mobil tarmoqlarda (4G/5G, NAT orqasida) ulanish uchun MAJBURIY.
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:your-turn-server.com:3478
TURN_USERNAME=turnuser
TURN_PASSWORD=turnpass
