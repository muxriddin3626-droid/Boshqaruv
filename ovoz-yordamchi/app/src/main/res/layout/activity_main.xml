<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Mikrofonni bosing"
        android:textColor="#FFB0BEC5"
        android:textSize="15sp" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="#FF1C2329"
        android:padding="12dp">

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Misollar:\n• Aliga qo'ng'iroq qil\n• Onamga sms yoz, uyga kechroq boraman\n• Akamga «qayerdasan» deb xabar yubor\n• Ko'tar  /  O'chir  (telefon jiringlaganda)\n• Fonarni yoq / o'chir\n• Soat necha?\n• Telegramni och"
            android:lineSpacingExtra="4dp"
            android:textColor="#FFECEFF1"
            android:textColorHint="#FF78909C"
            android:textSize="16sp" />
    </ScrollView>

    <ImageButton
        android:id="@+id/mic"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/mic_bg"
        android:contentDescription="Gapirish"
        android:padding="24dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_mic" />

    <Switch
        android:id="@+id/switch_calls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Qo'ng'iroq kelganda ovoz bilan ko'tarish / rad etish"
        android:textColor="#FFECEFF1" />

    <Switch
        android:id="@+id/switch_continuous"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Doimiy tinglash («Yordamchi, …» deb chaqiring)"
        android:textColor="#FFECEFF1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_permissions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ruxsatlar" />

        <Button
            android:id="@+id/btn_default"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Asosiy yordamchi qilish" />
    </LinearLayout>
</LinearLayout>
