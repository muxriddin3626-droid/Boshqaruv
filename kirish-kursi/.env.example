# Sessiya cookie'larini imzolash uchun tasodifiy va maxfiy qator (masalan: openssl rand -hex 32)
SESSION_SECRET=

# Lokal test uchun bo'sh qoldiring (./kirish-kursi.db fayliga saqlanadi).
# Doimiy joylashtirish uchun Turso (https://turso.tech) bazasi ma'lumotlari:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Sun'iy intellekt tahlili uchun Anthropic API kaliti (https://console.anthropic.com).
# Bo'sh qoldirilsa, tizim oddiy (AI'siz) tahlil bilan ishlaydi.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Kurs narxi (so'mda) va to'lov uchun murojaat manzili (Telegram username va h.k.)
COURSE_PRICE=300000
PAYMENT_CONTACT=@admin
