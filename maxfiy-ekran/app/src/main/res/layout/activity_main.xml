<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/intro" />

        <TextView
            android:id="@+id/permText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/perm_needed"
            android:textStyle="bold" />

        <Button
            android:id="@+id/permButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perm_button" />

        <Switch
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/toggle"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/strengthLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/strength" />

        <SeekBar
            android:id="@+id/strength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="80" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pattern" />

        <RadioGroup
            android:id="@+id/patternGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/patternLines"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pattern_lines" />

            <RadioButton
                android:id="@+id/patternGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pattern_grid" />

            <RadioButton
                android:id="@+id/patternEdges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pattern_edges" />

            <RadioButton
                android:id="@+id/patternDim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pattern_dim" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/tips_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tips" />

        <Button
            android:id="@+id/displayButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/open_display" />
    </LinearLayout>
</ScrollView>
