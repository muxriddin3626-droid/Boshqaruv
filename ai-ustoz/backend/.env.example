# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VISION_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# --- PostgreSQL (Supabase) ---
# Supabase connection string, asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Redis (state / session cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# --- Rate limiting (IP bo'yicha) ---
# Mobil operatorlar (CGNAT) va maktab Wi-Fi'larida ko'p o'quvchi bitta IP'dan
# chiqadi — shuning uchun limitlar yumshoq.
LOGIN_MAX_FAILURES_PER_IP=30
REGISTRATIONS_PER_IP_PER_HOUR=30
# Backend oldidagi ishonchli reverse proxy'lar soni (nginx/Render/Railway -> 1).
# Proksi bo'lmasa 0 qoldiring, aks holda IP'ni soxtalashtirish mumkin bo'ladi.
TRUSTED_PROXY_COUNT=0

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
CONVERSATION_HISTORY_TTL_SECONDS=86400
CONVERSATION_HISTORY_MAX_MESSAGES=30

# --- Supabase Storage (Modul 8: Audio Lecture Engine) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_AUDIO_BUCKET=audio_lectures
# Supabase bo'sh qoldirilsa, ma'ruza audiolari shu papkaga yoziladi (productionda doimiy disk bo'lsin)
MEDIA_DIR=media

# --- Web-search provider (Modul 7: Autonomous Researcher) ---
# Tavily/Serper uslubidagi JSON API. Bo'sh qoldirilsa, research skanerlari
# jim o'tkazib yuboriladi (xato tashlamaydi).
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=

# --- Autonomous scheduler (Modul 7) ---
RESEARCH_SCAN_ENABLED=false
RESEARCH_SCAN_INTERVAL_HOURS=24
INNOVATION_SCAN_INTERVAL_HOURS=24

# Darslik yuklash huquqi bor foydalanuvchilar (telefon raqamlari, vergul bilan)
ADMIN_PHONES=+998901234567
TEXTBOOK_MAX_MB=100
TEXTBOOK_OCR_MAX_PAGES=400
