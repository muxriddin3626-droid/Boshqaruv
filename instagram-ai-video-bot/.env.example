# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=

# Botni boshqara oladigan admin(lar)ning Telegram chat ID si.
# Bir nechta bo'lsa, vergul bilan ajrating: 111111,222222
# O'z chat ID'ingizni bilish uchun @userinfobot ga /start yozing.
ADMIN_CHAT_IDS=

# Fon videolar uchun Pexels API kaliti (bepul): https://www.pexels.com/api/
PEXELS_API_KEY=

# Ovoz (Microsoft Edge Read Aloud). Standart: o'zbekcha ayol ovozi.
# Boshqa variantlar: ru-RU-SvetlanaNeural, en-US-AriaNeural, uz-UZ-SardorNeural
TTS_VOICE=uz-UZ-MadinaNeural

# Instagram Graph API (Meta Business) ma'lumotlari.
# README.md dagi "Instagram sozlash" bo'limiga qarang.
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Bot joylashgan serverning tashqi (public) manzili - Instagram video faylni
# shu manzil orqali yuklab oladi. Render'da bu odatda:
# https://<xizmat-nomi>.onrender.com
PUBLIC_BASE_URL=

# true bo'lsa - bot har kuni video tayyorlab, AVTOMATIK Instagramga joylaydi.
# false (yoki bo'sh) bo'lsa - video tayyor bo'lgach, admin tasdiqlashini kutadi.
AUTO_POST=false

# Kunlik avtomatik video yaratish vaqti (soat:daqiqa, Toshkent vaqti bo'yicha)
DAILY_POST_HOUR=9
DAILY_POST_MINUTE=0

# Server porti (Render o'zi PORT ni beradi, lokal test uchun ixtiyoriy)
PORT=3000
