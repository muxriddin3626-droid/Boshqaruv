# Birja (ccxt nomi): binance, bybit, okx, kucoin, gateio, mexc ...
EXCHANGE=binance
API_KEY=
API_SECRET=
# Faqat OKX/KuCoin kabi birjalar uchun
API_PASSWORD=
# true = birjaning test tarmog'i (masalan, Binance testnet)
SANDBOX=false

# paper = xayoliy pul bilan sinov (standart). live = HAQIQIY pul!
MODE=paper
PAPER_START_USDT=1000

SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=1h
# O'rganish uchun nechta sham olinadi
HISTORY=1500
# Necha soatda bir bozor qayta o'rganiladi
RELEARN_HOURS=24
FEE_PCT=0.1

# Xavfni boshqarish
# Bitta savdoda stop urilsa yo'qotiladigan maksimal ulush (balansdan %)
RISK_PER_TRADE_PCT=1
# Bitta juftlikka ajratiladigan maksimal ulush (%)
MAX_POSITION_PCT=30
# Bir kunda balans shuncha % tushsa, o'sha kuni yangi savdo ochilmaydi
DAILY_LOSS_LIMIT_PCT=5

# Telegram (ixtiyoriy) — @BotFather dan token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sun'iy intellekt (Claude) — https://console.anthropic.com dan kalit oling.
# Kalit bo'lsa AI avtomatik yoqiladi; bo'lmasa oddiy kalit so'z tahlili ishlaydi.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high — chuqurroq tahlil qimmatroq
AI_EFFORT=medium
# AI o'zi internetda oxirgi yangiliklarni qidiradi
AI_WEB_SEARCH=true
# Necha daqiqada bir yangiliklar tahlil qilinadi
AI_EVERY_MINUTES=60
NEWS_ENABLED=true

# Manipulyatsiya (order book: spoofing devorlari, nomutanosiblik)
ORDERBOOK_CHECK=true
# Shuncha ketma-ket zarardan keyin sozlama chetlatilib, qayta o'rganiladi
LOSS_STREAK_RELEARN=3
EXCLUDE_DAYS=3

# Haftalik hisobot (0=yakshanba ... 6=shanba), soat — mahalliy vaqt bo'yicha
REPORT_DAY=0
REPORT_HOUR=20
# Kunlik hisobot soati (-1 = o'chirish)
DAILY_REPORT_HOUR=21
TZ_OFFSET_HOURS=5

# Server: holat sahifasi porti (Render kabi platformalar o'zi beradi)
# PORT=8080
# Diski o'chib ketadigan platformalar uchun holatni Turso'da saqlash
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
