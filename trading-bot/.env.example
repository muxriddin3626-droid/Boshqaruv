# Birja (ccxt nomi): binance, bybit, okx, kucoin, gateio, mexc ...
EXCHANGE=binance
API_KEY=
API_SECRET=
# Faqat OKX/KuCoin kabi birjalar uchun
API_PASSWORD=
# true = birjaning test tarmog'i (masalan, Binance testnet)
SANDBOX=false

# paper = xayoliy pul bilan sinov (standart). live = HAQIQIY pul!
MODE=paper
PAPER_START_USDT=1000

SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=1h
# O'rganish uchun nechta sham olinadi
HISTORY=1500
# Necha soatda bir bozor qayta o'rganiladi
RELEARN_HOURS=24
FEE_PCT=0.1

# Xavfni boshqarish
# Bitta savdoda stop urilsa yo'qotiladigan maksimal ulush (balansdan %)
RISK_PER_TRADE_PCT=1
# Bitta juftlikka ajratiladigan maksimal ulush (%)
MAX_POSITION_PCT=30
# Bir kunda balans shuncha % tushsa, o'sha kuni yangi savdo ochilmaydi
DAILY_LOSS_LIMIT_PCT=5

# Telegram (ixtiyoriy) — @BotFather dan token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
