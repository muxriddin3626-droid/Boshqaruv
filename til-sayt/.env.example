# https://console.anthropic.com dan olingan API kalit
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ixtiyoriy: model va javob chuqurligi (low | medium | high)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Ixtiyoriy: port (standart 3000, Render o'zi beradi)
# PORT=3000

# Ixtiyoriy: tabiiy ovoz (Microsoft Azure). Bo'lmasa brauzer o'z ovozida o'qiydi.
# Azure portalida "Speech service" yaratib, Keys and Endpoint bo'limidan oling.
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=westeurope

# ---------- Akkaunt (kirish: Telegram, Google, telefon) ----------
# Telegram:
# @BotFather'da bot yarating, /setdomain bilan sayt manzilingizni (masalan til-sayt.onrender.com) ulang.
# TELEGRAM_BOT_TOKEN=123456:your-bot-token
# TELEGRAM_BOT_USERNAME=TilUstozBot
# Google: Google Cloud → Credentials → OAuth client ID (Web application), sayt manzilini
# "Authorized JavaScript origins" ga qo'shing.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Telefon raqam (SMS kod): eskiz (O'zbekiston), twilio (xalqaro) yoki console (faqat sinov, kod logga yoziladi)
# SMS_PROVIDER=eskiz
# SMS_TEMPLATE=Til Ustoz: kirish kodingiz {code}   # Eskiz'da tasdiqlangan shablon bilan bir xil bo'lsin
# ESKIZ_EMAIL=siz@example.com
# ESKIZ_PASSWORD=eskiz-paroli
# ESKIZ_FROM=4546
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM=+15550001111
# Sessiya imzosi uchun uzun tasodifiy satr (o'zgartirsangiz, hamma qaytadan kiradi)
# SESSION_SECRET=uzun-tasodifiy-satr

# Baza: lokal fayl (standart: ./til-sayt.db) yoki Turso (doimiy saqlash uchun)
# DB_PATH=./til-sayt.db
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# ---------- Kunlik bepul limitlar va Premium ----------
# FREE_LIMITS=off            # limitlarni butunlay o'chirish
# FREE_LESSONS=2             # kuniga bepul ovozli darslar
# FREE_PRACTICE=6            # kuniga bepul o'yin va hikoyalar
# FREE_EXAM_SECTIONS=10      # kuniga bepul imtihon bo'limlari
# REF_BONUS_DAYS=3           # do'st taklif qilganda ikkalasiga Premium kunlari
# PREMIUM_PRICE=30 000 so'm / oy
# PREMIUM_CONTACT=@sizning_telegram
# ADMIN_SECRET=admin-panel-paroli          # /admin sahifasiga kirish va kod yaratish
# ADMIN_USER_IDS=123456789,p:998901234567   # bu akkauntlar /admin ga parolsiz kiradi (Telegram ID, p:telefon, g:google)

# ---------- Modellar ----------
# O'yin, hikoya, hisobot va imtihon topshiriqlari uchun tezroq model
# CLAUDE_FAST_MODEL=claude-sonnet-5-5
# CLAUDE_FAST_EFFORT=low
