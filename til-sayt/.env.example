# https://console.anthropic.com dan olingan API kalit
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ixtiyoriy: model va javob chuqurligi (low | medium | high)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Ixtiyoriy: port (standart 3000, Render o'zi beradi)
# PORT=3000

# Ixtiyoriy: tabiiy ovoz (Microsoft Azure). Bo'lmasa brauzer o'z ovozida o'qiydi.
# Azure portalida "Speech service" yaratib, Keys and Endpoint bo'limidan oling.
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=westeurope
